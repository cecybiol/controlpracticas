rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function logged(){return request.auth != null;}
  function hasProfile(){return logged() && exists(/databases/$(database)/documents/usuarios/$(request.auth.uid));}
  function profile(){return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data;}
  function admin(){return hasProfile() && profile().rol == 'admin';}
  function teacher(){return hasProfile() && profile().rol in ['admin','tutor'];}
  function ownStudent(id){return hasProfile() && profile().rol == 'alumno' && profile().alumnoId == id;}
  function ownRecord(){return logged() && ownStudent(resource.data.alumnoId);}
  match /usuarios/{uid} {allow read: if logged() && (request.auth.uid == uid || teacher()); allow write: if admin();}
  match /alumnos/{id} {allow read: if teacher() || ownStudent(id); allow write: if teacher();}
  match /practicas/{id} {allow read: if teacher() || ownRecord(); allow write: if teacher();}
  match /asistencias/{id} {allow read: if teacher() || ownRecord(); allow write: if teacher();}
  match /informes/{id} {allow read: if teacher() || ownRecord(); allow write: if teacher();}
  match /faltas/{id} {allow read: if teacher() || ownRecord(); allow write: if teacher();}
  match /lugares/{id} {allow read,write: if teacher();}
  match /config/{id} {allow read: if teacher(); allow write: if admin();}
  match /configuracion/{id} {
   allow read: if teacher();
   allow create: if teacher() && id == 'notificaciones' && request.resource.data.keys().hasOnly(['diasAviso','ccEmail','automatico','horaEnvio','acuerdosFolderId','adjuntosConfigurados']);
   allow update: if teacher() && id == 'notificaciones' && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['diasAviso','ccEmail','automatico','horaEnvio','acuerdosFolderId','adjuntosConfigurados']);
   allow write: if admin() && id == 'dashboard';
  }
  match /notificaciones_log/{id} {
   allow read: if teacher();
   allow create: if teacher() && request.resource.data.tipo == 'correo_particular' && request.resource.data.origen == 'manual';
  }
  match /notificaciones_envios/{id} {allow read: if teacher(); allow write: if false;}
  match /notificaciones_solicitudes/{id} {
   allow read: if teacher();
   allow create: if teacher()
    && request.resource.data.solicitanteUid == request.auth.uid
    && request.resource.data.estado == 'pendiente'
    && request.resource.data.creado is string
    && request.resource.data.accion in ['comprobar','enviar','particular']
    && request.resource.data.keys().hasOnly(['accion','solicitanteUid','estado','creado','practicaIds','cc','mensaje','nombre','email','asunto'])
    && (request.resource.data.accion != 'enviar' || (request.resource.data.practicaIds is list && request.resource.data.practicaIds.size() > 0 && request.resource.data.practicaIds.size() <= 100));
   allow update,delete: if false;
  }
 }
}
