rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function logged() { return request.auth != null; }
    function profile() { return get(/databases/$(database)/documents/usuarios/$(request.auth.uid)).data; }
    function admin() { return logged() && profile().rol == 'admin'; }
    function staff() { return logged() && profile().rol in ['admin', 'tutor']; }
    function studentId() { return profile().alumnoId; }

    match /usuarios/{uid} {
      allow read: if logged() && (request.auth.uid == uid || admin());
      allow write: if admin();
    }
    match /alumnos/{id} {
      allow read: if staff() || (logged() && profile().rol == 'alumno' && id == studentId());
      allow write: if staff();
    }
    match /practicas/{id} {
      allow read: if staff() || (logged() && profile().rol == 'alumno' && resource.data.alumnoId == studentId());
      allow write: if staff();
    }
    match /asistencias/{id} {
      allow read: if staff() || (logged() && profile().rol == 'alumno' && resource.data.alumnoId == studentId());
      allow write: if staff();
    }
    match /informes/{id} {
      allow read: if staff() || (logged() && profile().rol == 'alumno' && resource.data.alumnoId == studentId());
      allow write: if staff();
    }
    match /{document=**} {
      allow read, write: if staff();
    }
  }
}
