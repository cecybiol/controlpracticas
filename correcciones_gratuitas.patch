+const practiceId = p => 'import_'+encodeURIComponent([p.alumnoId,normalize(p.lugar),normalize(p.sector),normalize(p.tipo),p.fecha,p.fechaFin||p.fecha,p.horaInicio||'',p.horaFin||''].join('|'));
