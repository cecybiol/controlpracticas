+test('La prueba de adjuntos no realiza envíos ni escribe registros',async()=>{const d=await inspect();assert.equal(d.length,1);assert.equal(d[0].estado,'listo');});
+test('Cambiar práctica, correo o archivo invalida la identidad del intento',()=>{assert.notEqual(noticeKey(p,a),noticeKey({...p,sector:'otro'},a));assert.notEqual(noticeKey(p,a),noticeKey(p,{...a,email:'otro@example.com'}));assert.notEqual(noticeKey(p,a),noticeKey({...p,acuerdoNombre:'otro.pdf'},a));});
+test('Selección manual limita destinatarios',async()=>assert.deepEqual(await inspect({ids:['otra']}),[]));
+test('PDF faltantes al principio no impiden enviar los acuerdos listos',async()=>{let sends=0;const listo=(await inspect())[0],details=[...Array.from({length:25},(_,i)=>({estado:'bloqueado',practicaId:'f'+i,detalle:'Falta PDF'})),listo];const result=await dispatch(details,{send:async()=>sends++});assert.equal(sends,1);assert.equal(result.enviados,1);});
