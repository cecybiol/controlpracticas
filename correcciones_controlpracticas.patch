+test('Adjunta el PDF individual y su nombre al correo',async()=>{const [d]=await inspect();assert.equal(d.estado,'listo');assert.equal(d.params.adjunto_nombre,file.name);assert.equal(d.params.adjunto_acuerdo,'data:application/pdf;base64,'+pdf.toString('base64'));assert.equal(publicDetail(d).params,undefined);});
+test('Falta PDF bloquea sin enviar',async()=>{let sends=0;const d=await inspect({listFiles:async()=>[]});const r=await dispatch(d,{send:async()=>sends++});assert.equal(sends,0);assert.equal(r.errores,1);});
+test('Duplicidad de PDF bloquea sin enviar',async()=>{const [d]=await inspect({listFiles:async()=>[file,{...file,id:'2'}]});assert.equal(d.estado,'bloqueado');});
