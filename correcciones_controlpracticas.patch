+test('Si el registro falla después de enviar se propaga y no se libera claim',async()=>{let locked=false,sends=0;const details=await inspect(),opts={claim:async()=>{if(locked)return false;locked=true;return true;},send:async()=>sends++,recordResult:async()=>{throw Error('db');}};await assert.rejects(()=>dispatch(details,opts));await dispatch(details,opts);assert.equal(sends,1);});
